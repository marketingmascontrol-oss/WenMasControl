---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import { obtenerCategorias } from "../lib/productos";

Astro.response.status = 404;

const categorias = await obtenerCategorias();
---

<BaseLayout titulo="Página no encontrada" descripcion="Página no encontrada" noindex>
  <Header categorias={categorias} />

  <main class="mx-auto max-w-3xl px-4 py-24 text-center">
    <h1 class="text-3xl font-bold text-slate-900">404 — Página no encontrada</h1>
    <p class="mt-3 text-slate-600">El producto o categoría que buscas ya no existe o cambió de dirección.</p>
    <a href="/" class="mt-6 inline-block rounded-md bg-brand-500 px-6 py-3 text-sm font-semibold text-white hover:bg-brand-400">
      Volver al inicio
    </a>
  </main>

  <Footer categorias={categorias} />
</BaseLayout>
