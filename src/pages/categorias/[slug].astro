---
// Listado por categoría: on-demand (el admin edita el catálogo en vivo, ver
// Fase de panel admin) — se consulta Supabase en cada visita.
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
import ProductCard from "../../components/ui/ProductCard.astro";
import BreadcrumbSchema from "../../components/schema/BreadcrumbSchema.astro";
import {
  obtenerCategorias,
  obtenerCategoriaPorSlug,
  obtenerProductosPorCategoria,
} from "../../lib/productos";
import { obtenerResumenResenasPorProductos } from "../../lib/resenas";
import { SITE } from "../../lib/site";
import { marcaDe, rotuloSubcategoria } from "../../lib/ficha";

const { slug } = Astro.params;
const categoria = slug ? await obtenerCategoriaPorSlug(slug) : null;

if (!categoria) {
  return Astro.rewrite("/404");
}

const [categorias, productos] = await Promise.all([
  obtenerCategorias(),
  obtenerProductosPorCategoria(categoria.id),
]);
const resumenPorProducto = await obtenerResumenResenasPorProductos(productos.map((p) => p.id));

// Filtros de la categoría: Wincol lista la categoría entera en una grilla; acá
// se puede acotar por tipo (la subcategoría del catálogo) y por marca. Sólo
// aparecen los que tienen al menos dos opciones: un filtro de una sola opción
// no filtra nada.
function contar(valores: (string | null)[]): [string, number][] {
  const m = new Map<string, number>();
  for (const v of valores) if (v) m.set(v, (m.get(v) ?? 0) + 1);
  return [...m.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], "es"));
}
const tipos = contar(productos.map((p) => rotuloSubcategoria(p.sub_categoria)));
const marcas = contar(productos.map((p) => marcaDe(p)));
const enBodega = productos.filter((p) => p.stock > 0).length;

const breadcrumbItems = [
  { nombre: "Inicio", url: SITE.url },
  { nombre: categoria.nombre, url: new URL(`/categorias/${categoria.slug}`, SITE.url).toString() },
];
---

<BaseLayout
  titulo={categoria.nombre}
  descripcion={`Catálogo de ${categoria.nombre} — ${SITE.descripcion}`}
>
  <Fragment slot="head">
    <BreadcrumbSchema items={breadcrumbItems} />
  </Fragment>

  <Header categorias={categorias} />

  <main>
    <section class="relative overflow-hidden bg-brand-500 text-white">
      <div class="relative mx-auto flex max-w-7xl items-end justify-between gap-8 px-4 pb-10 pt-6 sm:pb-14">
        <div>
        <nav aria-label="Breadcrumb" class="text-[13px] text-[#AEB4C4]">
          <a href="/" class="hover:text-white">Inicio</a> <span class="mx-1 opacity-60">/</span> <a href="/categorias" class="hover:text-white">Catálogo</a>
        </nav>
        <h1 class="mt-8 max-w-3xl text-4xl font-black leading-none tracking-[-0.04em] sm:text-6xl">{categoria.nombre}</h1>
        <p class="mt-4 text-[15px] text-[#AEB4C4]">
          <span class="font-bold text-white">{productos.length}</span> referencias · <span class="font-bold text-white">{enBodega}</span> en bodega para entrega inmediata
        </p>
        </div>
        {/* Las portadas vienen con fondo blanco: sobre Blanco Técnico y en
            multiply se integran; sueltas sobre el azul serían un recuadro. */}
        {categoria.imagen_url && (
          <div class="hidden h-40 w-40 shrink-0 items-center justify-center rounded-[6px] bg-tecnico p-4 md:flex lg:h-48 lg:w-48">
            <img src={categoria.imagen_url} alt="" aria-hidden="true" class="h-full w-full object-contain mix-blend-multiply" />
          </div>
        )}
      </div>
      <div class="franja-plata" aria-hidden="true"></div>
    </section>

    {productos.length > 0 ? (
      <div data-catalogo class="mx-auto max-w-7xl px-4 pb-16">
        <div class="sticky top-[var(--alto-header,0px)] z-20 -mx-4 border-b border-linea bg-white/95 px-4 py-3 backdrop-blur">
          <div class="flex flex-wrap items-center gap-2">
            {tipos.length > 1 && (
              <div class="-mx-1 flex max-w-full gap-1.5 overflow-x-auto px-1" role="group" aria-label="Tipo de producto">
                <button type="button" data-tipo="" aria-pressed="true" class="shrink-0 rounded-full border border-linea px-3 py-1.5 text-[13px] font-semibold text-acero aria-pressed:border-brand-500 aria-pressed:bg-brand-500 aria-pressed:text-white">Todo</button>
                {tipos.map(([t, n]) => (
                  <button type="button" data-tipo={t} aria-pressed="false" class="shrink-0 rounded-full border border-linea px-3 py-1.5 text-[13px] font-semibold text-acero hover:border-brand-500 hover:text-brand-500 aria-pressed:border-brand-500 aria-pressed:bg-brand-500 aria-pressed:text-white">
                    {t} <span class="opacity-60">{n}</span>
                  </button>
                ))}
              </div>
            )}
            <div class="ml-auto flex flex-wrap items-center gap-2">
              {marcas.length > 1 && (
                <select data-marca aria-label="Marca" class="rounded-[6px] border border-linea bg-white px-3 py-1.5 text-[13px] font-semibold text-brand-500">
                  <option value="">Todas las marcas</option>
                  {marcas.map(([m, n]) => <option value={m}>{m} ({n})</option>)}
                </select>
              )}
              <label class="flex cursor-pointer items-center gap-2 rounded-[6px] border border-linea px-3 py-1.5 text-[13px] font-semibold text-brand-500">
                <input type="checkbox" data-solo-stock class="accent-[#181c37]" /> En bodega
              </label>
              <select data-orden aria-label="Ordenar" class="rounded-[6px] border border-linea bg-white px-3 py-1.5 text-[13px] font-semibold text-brand-500">
                <option value="">Recomendados</option>
                <option value="precio-asc">Menor precio</option>
                <option value="precio-desc">Mayor precio</option>
                <option value="nombre">Nombre A–Z</option>
              </select>
            </div>
          </div>
        </div>

        <p class="mt-5 text-[13px] text-acero"><span data-conteo class="font-bold text-brand-500">{productos.length}</span> de {productos.length} referencias</p>
        <div data-grilla class="mt-4 grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 lg:grid-cols-4">
          {productos.map((producto) => (
            <ProductCard producto={producto} resumenResenas={resumenPorProducto.get(producto.id)} />
          ))}
        </div>
        <div data-vacio class="mt-8 hidden rounded-[6px] bg-tecnico p-8 text-center">
          <p class="font-bold text-brand-500">Nada coincide con esos filtros.</p>
          <button type="button" data-limpiar class="mt-2 text-sm font-semibold text-acero underline underline-offset-2 hover:text-brand-500">Quitar filtros</button>
        </div>
      </div>
    ) : (
      <p class="mx-auto max-w-7xl px-4 py-16 text-sm text-acero">Aún no hay productos publicados en esta categoría.</p>
    )}
  </main>

  <Footer categorias={categorias} />
</BaseLayout>

<script>
  // Filtro y orden en el navegador: la categoría más grande tiene unas 25
  // referencias, todas ya pintadas por el servidor. Pedirle a Supabase cada
  // combinación sería más lento que esconder tarjetas.
  const catalogo = document.querySelector<HTMLElement>("[data-catalogo]");
  if (catalogo) {
    const grilla = catalogo.querySelector<HTMLElement>("[data-grilla]")!;
    const tarjetas = [...grilla.querySelectorAll<HTMLElement>("[data-tarjeta]")];
    const ordenOriginal = new Map(tarjetas.map((t, i) => [t, i]));
    const botonesTipo = [...catalogo.querySelectorAll<HTMLButtonElement>("[data-tipo]")];
    const selMarca = catalogo.querySelector<HTMLSelectElement>("[data-marca]");
    const selOrden = catalogo.querySelector<HTMLSelectElement>("[data-orden]");
    const soloStock = catalogo.querySelector<HTMLInputElement>("[data-solo-stock]");
    const conteo = catalogo.querySelector<HTMLElement>("[data-conteo]");
    const vacio = catalogo.querySelector<HTMLElement>("[data-vacio]");
    let tipo = "";

    function aplicar() {
      const marca = selMarca?.value ?? "";
      let visibles = 0;
      for (const t of tarjetas) {
        const ok =
          (!tipo || t.dataset.sub === tipo) &&
          (!marca || t.dataset.marca === marca) &&
          (!soloStock?.checked || Number(t.dataset.stock) > 0);
        t.hidden = !ok;
        if (ok) visibles++;
      }
      const orden = selOrden?.value ?? "";
      const precio = (t: HTMLElement) => Number(t.dataset.precio);
      const ordenadas = [...tarjetas].sort((a, b) =>
        orden === "precio-asc" ? precio(a) - precio(b)
        : orden === "precio-desc" ? precio(b) - precio(a)
        : orden === "nombre" ? (a.dataset.nombre ?? "").localeCompare(b.dataset.nombre ?? "", "es")
        : ordenOriginal.get(a)! - ordenOriginal.get(b)!
      );
      grilla.append(...ordenadas);
      if (conteo) conteo.textContent = String(visibles);
      vacio?.classList.toggle("hidden", visibles > 0);
    }

    botonesTipo.forEach((b) =>
      b.addEventListener("click", () => {
        tipo = b.dataset.tipo ?? "";
        botonesTipo.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
        aplicar();
      })
    );
    selMarca?.addEventListener("change", aplicar);
    selOrden?.addEventListener("change", aplicar);
    soloStock?.addEventListener("change", aplicar);
    catalogo.querySelector("[data-limpiar]")?.addEventListener("click", () => {
      tipo = "";
      botonesTipo.forEach((x) => x.setAttribute("aria-pressed", String(x.dataset.tipo === "")));
      if (selMarca) selMarca.value = "";
      if (soloStock) soloStock.checked = false;
      aplicar();
    });
  }
</script>
