---
// PDP: on-demand (el admin edita precio/stock/descripciones/imágenes en vivo,
// ver Fase de panel admin) — se consulta Supabase en cada visita, así que no
// hace falta un refresco aparte de precio/stock en el cliente.
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
import Gallery from "../../components/pdp/Gallery.astro";
import PedidoPorTallas from "../../components/pdp/PedidoPorTallas.astro";
import RelatedProducts from "../../components/pdp/RelatedProducts.astro";
import Resenas from "../../components/pdp/Resenas.astro";
import Estrellas from "../../components/ui/Estrellas.astro";
import ProductSchema from "../../components/schema/ProductSchema.astro";
import BreadcrumbSchema from "../../components/schema/BreadcrumbSchema.astro";
import {
  obtenerProductoPorSlug,
  obtenerCategorias,
  obtenerProductosPorCategoria,
} from "../../lib/productos";
import { obtenerResenasAprobadas, obtenerResumenResenas } from "../../lib/resenas";
import { SITE } from "../../lib/site";
import { nombreLegible } from "../../lib/formato";
import { leerFicha, marcaDe } from "../../lib/ficha";

const { slug } = Astro.params;
const producto = slug ? await obtenerProductoPorSlug(slug) : null;

if (!producto) {
  return Astro.rewrite("/404");
}

const [categorias, productosDeLaCategoria, resenas, resumenResenas] = await Promise.all([
  obtenerCategorias(),
  producto.categoria_id ? obtenerProductosPorCategoria(producto.categoria_id) : Promise.resolve([]),
  obtenerResenasAprobadas(producto.id),
  obtenerResumenResenas(producto.id),
]);

const relacionados = productosDeLaCategoria.filter((p) => p.id !== producto.id).slice(0, 4);

// La descripción corta casi siempre es una ficha «Etiqueta: valor» (ver
// lib/ficha.ts): se muestra como tabla, y la marca sube al encabezado.
const ficha = leerFicha(producto.descripcion_corta);
const marca = marcaDe(producto);
const datosFicha = ficha.datos.filter((d) => !/^marca$/i.test(d.etiqueta));


// item_id tiene que ser el SKU: el mismo valor que lleva `g:id` en los feeds
// (src/lib/feed.ts). Si el píxel manda el UUID de Supabase, Meta no empareja la
// vista con el producto del catálogo y Advantage+ deja de reimpactar con la
// foto correcta. Se serializa en el DOM y no con define:vars, porque eso
// convertiría el script en inline y no podría importar la capa de datos.
const datosCapa = JSON.stringify({
  item_id: producto.sku,
  item_name: producto.nombre,
  price: producto.precio,
  item_category: producto.categoria?.nombre,
});

const breadcrumbItems = [
  { nombre: "Inicio", url: SITE.url },
  ...(producto.categoria
    ? [
        {
          nombre: producto.categoria.nombre,
          url: new URL(`/categorias/${producto.categoria.slug}`, SITE.url).toString(),
        },
      ]
    : []),
  { nombre: producto.nombre, url: new URL(`/productos/${producto.slug}`, SITE.url).toString() },
];
---

<BaseLayout titulo={producto.nombre} descripcion={producto.descripcion_corta ?? producto.nombre}>
  <Fragment slot="head">
    <ProductSchema producto={producto} resumenResenas={resumenResenas} />
    <BreadcrumbSchema items={breadcrumbItems} />
  </Fragment>

  <Header categorias={categorias} />

  <main>
    {/* Encabezado de la ficha: en Azul Mando, a todo el ancho. Wincol abre la
        ficha con tres columnas sobre blanco; acá el nombre, la referencia y la
        marca se leen primero, como en la portada de una ficha técnica. */}
    <section class="bg-brand-500 text-white">
      <div class="mx-auto max-w-7xl px-4 pb-8 pt-6 sm:pb-10">
        <nav aria-label="Breadcrumb" class="text-[13px] text-[#AEB4C4]">
          <ol class="flex flex-wrap gap-x-2">
            {breadcrumbItems.slice(0, -1).map((item, i) => (
              <li>
                {i > 0 && <span class="mr-2 opacity-60">/</span>}
                <a href={item.url} class="hover:text-white">{item.nombre}</a>
              </li>
            ))}
          </ol>
        </nav>
        <div class="mt-6 flex flex-wrap items-center gap-2 text-[12px] font-semibold">
          <span class="rounded-[4px] bg-white/10 px-2 py-1 tabular-nums">Ref. {producto.sku}</span>
          {marca && <span class="rounded-[4px] bg-white/10 px-2 py-1">Marca {marca}</span>}
          {producto.en_promocion && <span class="rounded-[4px] bg-white px-2 py-1 font-bold uppercase tracking-wide text-senal">Promoción</span>}
        </div>
        <h1 class="mt-3 max-w-4xl text-3xl font-black leading-[1.02] tracking-[-0.035em] sm:text-5xl">
          {nombreLegible(producto.nombre)}
        </h1>
        {resumenResenas.total > 0 && (
          <a href="#resenas" class="mt-3 inline-block hover:opacity-80">
            <Estrellas promedio={resumenResenas.promedio} total={resumenResenas.total} tamano="md" />
          </a>
        )}
      </div>
      <div class="franja-plata" aria-hidden="true"></div>
    </section>

    <article itemscope itemtype="https://schema.org/Product" class="mx-auto grid max-w-7xl gap-10 px-4 py-10 lg:grid-cols-12 lg:gap-12">
      <meta itemprop="name" content={producto.nombre} />
      <meta itemprop="sku" content={producto.sku} />
      {/* En el celular el orden es foto → pedido → ficha: la caja de compra no
          puede quedar debajo de toda la ficha técnica. En escritorio el pedido
          ocupa la columna derecha, a lo alto de las dos filas, y se pega. */}
      <div class="lg:col-span-7">
        <Gallery imagenes={producto.imagenes} nombre={producto.nombre} />
      </div>

      <div class="lg:sticky lg:top-[calc(var(--alto-header,120px)+1.5rem)] lg:col-span-5 lg:col-start-8 lg:row-span-2 lg:row-start-1 lg:self-start">
        <PedidoPorTallas producto={producto} />
      </div>

      <div class="space-y-12 lg:col-span-7">

        {datosFicha.length > 0 && (
          <section>
            <div class="flex items-baseline justify-between border-b-[3px] border-brand-500 pb-2">
              <h2 class="text-xl font-black tracking-[-0.02em] text-brand-500">Ficha técnica</h2>
              <span class="text-[12px] font-semibold tabular-nums text-acero">Ref. {producto.sku}</span>
            </div>
            <dl class="divide-y divide-linea">
              {marca && (
                <div class="grid gap-1 py-3 sm:grid-cols-[180px_1fr] sm:gap-6">
                  <dt class="text-[13px] font-semibold text-acero">Marca</dt>
                  <dd class="text-[15px] font-bold text-brand-500">{marca}</dd>
                </div>
              )}
              {datosFicha.map((d) => (
                <div class="grid gap-1 py-3 sm:grid-cols-[180px_1fr] sm:gap-6">
                  <dt class="text-[13px] font-semibold text-acero">{d.etiqueta}</dt>
                  <dd class="text-[15px] text-brand-500">{d.valor}</dd>
                </div>
              ))}
              {producto.categoria && (
                <div class="grid gap-1 py-3 sm:grid-cols-[180px_1fr] sm:gap-6">
                  <dt class="text-[13px] font-semibold text-acero">Categoría</dt>
                  <dd class="text-[15px] text-brand-500"><a href={`/categorias/${producto.categoria.slug}`} class="underline-offset-4 hover:underline">{producto.categoria.nombre}</a></dd>
                </div>
              )}
            </dl>
          </section>
        )}

        {(producto.descripcion_larga || (datosFicha.length === 0 && producto.descripcion_corta) || ficha.resto) && (
          <section itemprop="description">
            <h2 class="border-b-[3px] border-brand-500 pb-2 text-xl font-black tracking-[-0.02em] text-brand-500">Para qué sirve</h2>
            {datosFicha.length === 0 && producto.descripcion_corta && (
              <p class="mt-4 whitespace-pre-line text-[15px] leading-relaxed text-acero">{producto.descripcion_corta}</p>
            )}
            {ficha.resto && datosFicha.length > 0 && (
              <p class="mt-4 whitespace-pre-line text-[15px] leading-relaxed text-acero">{ficha.resto}</p>
            )}
            {producto.descripcion_larga && (
              <p class="mt-4 whitespace-pre-line text-[15px] leading-relaxed text-acero">{producto.descripcion_larga}</p>
            )}
          </section>
        )}

        <section>
          <h2 class="border-b-[3px] border-brand-500 pb-2 text-xl font-black tracking-[-0.02em] text-brand-500">Así compra en +Control</h2>
          <ol class="mt-4 grid gap-4 sm:grid-cols-3">
            {[
              ["01", "Arme el pedido", "Tallas y cantidades en la misma ficha, varios productos en un solo pedido."],
              ["02", "Lo envía por WhatsApp", "Le confirmamos stock, precio por volumen y fecha de entrega."],
              ["03", "Recibe con factura", "Factura electrónica a nombre de su empresa. Despachos a todo el país."],
            ].map(([n, t, d]) => (
              <li class="rounded-[6px] bg-tecnico p-4">
                <span class="text-[12px] font-bold tabular-nums text-acero">{n}</span>
                <p class="mt-1 font-extrabold text-brand-500">{t}</p>
                <p class="mt-1 text-[13px] text-acero">{d}</p>
              </li>
            ))}
          </ol>
        </section>
      </div>
    </article>

    <div hidden data-producto-capa-datos={datosCapa}></div>

    <div class="mx-auto max-w-7xl px-4 pb-16">
      <Resenas productoId={producto.id} resenas={resenas} resumen={resumenResenas} />
      <RelatedProducts productos={relacionados} />
    </div>
  </main>

  <Footer categorias={categorias} />
</BaseLayout>

<script>
  import { EVENTOS, empujar } from "../../lib/capa-datos";
  import { verProducto } from "../../lib/meta";

  const nodo = document.querySelector<HTMLElement>("[data-producto-capa-datos]");
  const crudo = nodo?.dataset.productoCapaDatos;

  if (crudo) {
    try {
      const item = JSON.parse(crudo);
      empujar(EVENTOS.verProducto, { value: item.price, items: [item] });
      verProducto({ sku: item.item_id, precio: item.price });
    } catch {
      // Datos mal formados: se omite el evento antes que romper la ficha.
    }
  }
</script>
