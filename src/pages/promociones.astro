---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import ProductCard from "../components/ui/ProductCard.astro";
import { obtenerCategorias, obtenerProductosEnPromocion } from "../lib/productos";
import { obtenerResumenResenasPorProductos } from "../lib/resenas";
import { SITE } from "../lib/site";

const [categorias, promociones] = await Promise.all([
  obtenerCategorias(),
  obtenerProductosEnPromocion(),
]);
const resumenPorProducto = await obtenerResumenResenasPorProductos(promociones.map((p) => p.id));
---

<BaseLayout
  titulo="Promociones"
  descripcion={`Ofertas y promociones de EPP y dotación industrial — ${SITE.descripcion}`}
>
  <Header categorias={categorias} />

  <main class="mx-auto max-w-7xl px-4 py-8">
    <p class="flex items-center gap-2 text-xs font-semibold text-acero"><span class="h-[3px] w-5 bg-senal" aria-hidden="true"></span>+Control</p>
    <h1 class="mb-6 mt-1 text-2xl font-bold text-slate-900">Promociones</h1>

    {promociones.length > 0 ? (
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
        {promociones.map((producto) => (
          <ProductCard producto={producto} resumenResenas={resumenPorProducto.get(producto.id)} />
        ))}
      </div>
    ) : (
      <p class="text-sm text-slate-500">No hay promociones activas en este momento.</p>
    )}
  </main>

  <Footer categorias={categorias} />
</BaseLayout>
