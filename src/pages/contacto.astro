---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import { obtenerCategorias } from "../lib/productos";
import { SITE } from "../lib/site";
import { construirEnlaceWhatsAppAsesor } from "../lib/whatsapp";
import { COOKIE_REF } from "../lib/atribucion";

const categorias = await obtenerCategorias();

// Antes era un wa.me pelado, sin mensaje: el asesor recibía un «hola» sin
// contexto y la conversación arrancaba de cero. Ahora sale con la intención ya
// escrita, igual que el hero y /cotizar.
const whatsappHref = construirEnlaceWhatsAppAsesor(
  undefined,
  Astro.cookies.get(COOKIE_REF)?.value ?? null,
);
---

<BaseLayout titulo="Contacto" descripcion={`Cotiza tu compra al por mayor — ${SITE.descripcion}`}>
  <Header categorias={categorias} />

  <main class="mx-auto max-w-2xl px-4 py-16 text-center">
    <h1 class="text-2xl font-bold text-slate-900">Cotiza tu compra al por mayor</h1>
    <p class="mt-3 text-slate-600">
      Escríbenos y te asesoramos para elegir el EPP correcto y armar tu pedido con precios preferenciales por volumen.
    </p>

    <div class="mt-8 flex flex-col gap-3">
      <a
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        data-wa-origen="contacto"
        class="inline-flex items-center justify-center gap-2.5 rounded-md bg-[#25D366] px-6 py-4 text-base font-bold text-slate-900 transition hover:bg-[#20BD5A]"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0" fill="currentColor" aria-hidden="true">
          <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.87 9.87 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.13h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.11.82.83-3.04-.2-.31a8.17 8.17 0 0 1-1.25-4.36c0-4.53 3.7-8.22 8.23-8.22 2.2 0 4.26.86 5.81 2.41a8.16 8.16 0 0 1 2.41 5.82c0 4.53-3.69 8.21-8.23 8.21Z"/>
        </svg>
        Hablar con un asesor por WhatsApp
      </a>

      <div class="grid gap-3 sm:grid-cols-2">
        <a
          href="/cotizar"
          class="rounded-md border border-slate-300 px-6 py-3 text-sm font-semibold text-slate-700 transition hover:border-slate-400"
        >
          Pedir cotización por escrito
        </a>
        <a
          href={`mailto:${SITE.email}`}
          class="rounded-md border border-slate-300 px-6 py-3 text-sm font-semibold text-slate-700 transition hover:border-slate-400"
        >
          Escribir por email
        </a>
      </div>
    </div>

    <dl class="mt-10 space-y-2 text-sm text-slate-600">
      <div><dt class="inline font-semibold text-slate-900">Teléfono: </dt><dd class="inline">{SITE.telefono}</dd></div>
      <div><dt class="inline font-semibold text-slate-900">Email: </dt><dd class="inline">{SITE.email}</dd></div>
      <div><dt class="inline font-semibold text-slate-900">Dirección: </dt><dd class="inline">{SITE.direccion}</dd></div>
    </dl>
  </main>

  <Footer categorias={categorias} />
</BaseLayout>
