---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { supabaseAdmin } from "../../lib/supabase-admin";
import { actions } from "astro:actions";

const resultadoGuardar = Astro.getActionResult(actions.guardarCategoria);
const resultadoEliminar = Astro.getActionResult(actions.eliminarCategoria);
const resultadoImagen = Astro.getActionResult(actions.subirImagenCategoria);
const error =
  resultadoGuardar?.error?.message ?? resultadoEliminar?.error?.message ?? resultadoImagen?.error?.message;

const { data: categorias, error: errorConsulta } = await supabaseAdmin
  .from("categorias")
  .select("*")
  .order("nombre");

if (errorConsulta) throw new Error(errorConsulta.message);
---

<AdminLayout titulo="Categorías">
  <h1 class="mb-6 text-2xl font-bold text-slate-900">Categorías</h1>

  {error && <p class="mb-4 text-sm text-red-600">{error}</p>}

  <form method="POST" action={actions.guardarCategoria} enctype="multipart/form-data" class="mb-6 flex flex-wrap items-center gap-2">
    <input
      name="nombre"
      placeholder="Nueva categoría..."
      required
      class="w-full max-w-xs rounded-md border border-slate-300 px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-brand-500"
    />
    <input
      type="file"
      name="archivo"
      accept="image/*"
      class="text-xs file:mr-2 file:cursor-pointer file:rounded-md file:border-0 file:bg-slate-100 file:px-2 file:py-1.5 file:text-xs file:font-medium file:text-slate-700 hover:file:bg-slate-200"
    />
    <button type="submit" class="rounded-md bg-brand-500 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-400">
      Agregar
    </button>
  </form>

  <div class="space-y-3">
    {(categorias ?? []).map((categoria) => (
      <div class="flex flex-wrap items-center gap-4 rounded-lg border border-slate-200 bg-white p-4">
        <div class="flex h-16 w-16 shrink-0 items-center justify-center overflow-hidden rounded-md border border-slate-100 bg-slate-50">
          {categoria.imagen_url ? (
            <img src={categoria.imagen_url} alt={categoria.nombre} class="h-full w-full object-cover" />
          ) : (
            <span class="text-[10px] text-slate-400">Sin imagen</span>
          )}
        </div>

        <form method="POST" action={actions.guardarCategoria} class="flex flex-1 items-center gap-2">
          <input type="hidden" name="id" value={categoria.id} />
          <input
            name="nombre"
            value={categoria.nombre}
            class="w-full max-w-xs rounded-md border border-slate-300 px-3 py-1.5 text-sm outline-none focus:ring-2 focus:ring-brand-500"
          />
          <button type="submit" class="text-sm text-brand-600 hover:text-brand-700">Guardar</button>
        </form>

        <form method="POST" action={actions.subirImagenCategoria} enctype="multipart/form-data" class="flex items-center gap-2">
          <input type="hidden" name="categoria_id" value={categoria.id} />
          <input type="hidden" name="slug" value={categoria.slug} />
          <input
            type="file"
            name="archivo"
            accept="image/*"
            required
            class="text-xs file:mr-2 file:cursor-pointer file:rounded-md file:border-0 file:bg-slate-100 file:px-2 file:py-1 file:text-xs file:font-medium file:text-slate-700 hover:file:bg-slate-200"
          />
          <button type="submit" class="text-sm font-medium text-slate-700 hover:text-slate-900">Subir portada</button>
        </form>

        <form method="POST" action={actions.eliminarCategoria}>
          <input type="hidden" name="id" value={categoria.id} />
          <button type="submit" class="text-sm text-slate-400 hover:text-red-600">Eliminar</button>
        </form>
      </div>
    ))}
  </div>
</AdminLayout>
