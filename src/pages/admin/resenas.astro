---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { supabaseAdmin } from "../../lib/supabase-admin";
import { actions } from "astro:actions";

const resultadoAgregar = Astro.getActionResult(actions.agregarResenaAdmin);
const resultadoAprobar = Astro.getActionResult(actions.aprobarResena);
const resultadoEliminar = Astro.getActionResult(actions.eliminarResena);
const error =
  resultadoAgregar?.error?.message ?? resultadoAprobar?.error?.message ?? resultadoEliminar?.error?.message;

const [{ data: resenas, error: errorResenas }, { data: productos }] = await Promise.all([
  supabaseAdmin
    .from("resenas")
    .select("id, autor_nombre, calificacion, comentario, aprobada, created_at, producto:productos(sku, nombre)")
    .order("created_at", { ascending: false }),
  supabaseAdmin.from("productos").select("id, sku, nombre").order("nombre"),
]);

if (errorResenas) throw new Error(errorResenas.message);

const pendientes = (resenas ?? []).filter((r) => !r.aprobada);
const aprobadas = (resenas ?? []).filter((r) => r.aprobada);
---

<AdminLayout titulo="Reseñas">
  <h1 class="mb-6 text-2xl font-bold text-slate-900">Reseñas</h1>

  {error && <p class="mb-4 rounded-md bg-red-50 px-3 py-2 text-sm text-red-700">{error}</p>}

  <section class="mb-10 rounded-lg border border-slate-200 bg-white p-6">
    <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-slate-500">
      Agregar reseña (queda aprobada directamente)
    </h2>
    <form method="POST" action={actions.agregarResenaAdmin} class="grid gap-3 sm:grid-cols-2">
      <div class="sm:col-span-2">
        <label class="block text-xs font-medium text-slate-700">Producto</label>
        <select name="producto_id" required class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm">
          {(productos ?? []).map((p) => (
            <option value={p.id}>{p.nombre} ({p.sku})</option>
          ))}
        </select>
      </div>
      <div>
        <label class="block text-xs font-medium text-slate-700">Nombre del autor</label>
        <input name="autor_nombre" required maxlength="80" class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" />
      </div>
      <div>
        <label class="block text-xs font-medium text-slate-700">Calificación</label>
        <select name="calificacion" required class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm">
          <option value="5">5 - Excelente</option>
          <option value="4">4 - Muy bueno</option>
          <option value="3">3 - Bueno</option>
          <option value="2">2 - Regular</option>
          <option value="1">1 - Malo</option>
        </select>
      </div>
      <div class="sm:col-span-2">
        <label class="block text-xs font-medium text-slate-700">Comentario</label>
        <textarea name="comentario" rows="2" maxlength="1000" class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm"></textarea>
      </div>
      <button type="submit" class="rounded-md bg-brand-500 px-5 py-2 text-sm font-semibold text-white hover:bg-brand-400 sm:w-fit">
        Agregar reseña
      </button>
    </form>
  </section>

  <section class="mb-10">
    <h2 class="mb-3 text-lg font-bold text-slate-900">Pendientes de aprobar ({pendientes.length})</h2>
    {pendientes.length === 0 ? (
      <p class="text-sm text-slate-500">No hay reseñas pendientes.</p>
    ) : (
      <div class="space-y-3">
        {pendientes.map((r) => (
          <div class="rounded-lg border border-amber-200 bg-amber-50 p-4">
            <div class="flex items-center justify-between">
              <p class="text-sm font-semibold text-slate-900">
                {r.autor_nombre} — {"★".repeat(r.calificacion)}{"☆".repeat(5 - r.calificacion)}
              </p>
              <p class="text-xs text-slate-500">{(r.producto as unknown as { nombre: string } | null)?.nombre}</p>
            </div>
            {r.comentario && <p class="mt-1 text-sm text-slate-700">{r.comentario}</p>}
            <div class="mt-3 flex gap-3">
              <form method="POST" action={actions.aprobarResena}>
                <input type="hidden" name="id" value={r.id} />
                <button type="submit" class="text-sm font-medium text-green-700 hover:underline">Aprobar</button>
              </form>
              <form method="POST" action={actions.eliminarResena}>
                <input type="hidden" name="id" value={r.id} />
                <button type="submit" class="text-sm font-medium text-red-600 hover:underline">Eliminar</button>
              </form>
            </div>
          </div>
        ))}
      </div>
    )}
  </section>

  <section>
    <h2 class="mb-3 text-lg font-bold text-slate-900">Aprobadas ({aprobadas.length})</h2>
    {aprobadas.length === 0 ? (
      <p class="text-sm text-slate-500">Todavía no hay reseñas aprobadas.</p>
    ) : (
      <div class="space-y-3">
        {aprobadas.map((r) => (
          <div class="rounded-lg border border-slate-200 p-4">
            <div class="flex items-center justify-between">
              <p class="text-sm font-semibold text-slate-900">
                {r.autor_nombre} — {"★".repeat(r.calificacion)}{"☆".repeat(5 - r.calificacion)}
              </p>
              <p class="text-xs text-slate-500">{(r.producto as unknown as { nombre: string } | null)?.nombre}</p>
            </div>
            {r.comentario && <p class="mt-1 text-sm text-slate-700">{r.comentario}</p>}
            <form method="POST" action={actions.eliminarResena} class="mt-3">
              <input type="hidden" name="id" value={r.id} />
              <button type="submit" class="text-sm font-medium text-red-600 hover:underline">Eliminar</button>
            </form>
          </div>
        ))}
      </div>
    )}
  </section>
</AdminLayout>
