---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { supabaseAdmin } from "../../lib/supabase-admin";
import { formatearPrecio } from "../../lib/formato";
import { estadoStock } from "../../lib/inventario";
import { actions } from "astro:actions";

const resultadoEliminar = Astro.getActionResult(actions.eliminarProductoDefinitivo);

const categoriaSeleccionada = Astro.url.searchParams.get("categoria") ?? "";
// "rotacion" no tiene datos de ventas reales (el checkout es por WhatsApp, sin
// registro en la base): se usa el stock más bajo como aproximación de qué se
// está moviendo más rápido, a falta de algo mejor.
const orden = Astro.url.searchParams.get("orden") ?? "alerta";

const [{ data: productos, error }, { data: categorias }] = await Promise.all([
  supabaseAdmin
    .from("productos")
    .select(
      "id, sku, nombre, precio, stock, activo, categoria:categorias(id, nombre), imagenes:producto_imagenes(url, es_principal, orden)"
    )
    .order("nombre"),
  supabaseAdmin.from("categorias").select("id, nombre").order("nombre"),
]);

if (error) throw new Error(error.message);

const productosFiltrados = categoriaSeleccionada
  ? (productos ?? []).filter(
      (p) => (p.categoria as unknown as { id: string } | null)?.id === categoriaSeleccionada
    )
  : (productos ?? []);

// sort() es estable: dentro de cada grupo/orden se conserva el orden
// alfabético que ya trae la consulta.
const ordenAlerta: Record<ReturnType<typeof estadoStock>, number> = { agotado: 0, bajo: 1, ok: 2 };
const productosOrdenados = [...productosFiltrados].sort((a, b) => {
  if (orden === "rotacion") return a.stock - b.stock;
  if (orden === "nombre") return 0; // ya viene alfabético de la consulta
  return ordenAlerta[estadoStock(a.stock)] - ordenAlerta[estadoStock(b.stock)];
});
---

<AdminLayout titulo="Productos">
  <div class="mb-6 flex items-center justify-between">
    <h1 class="text-2xl font-bold text-slate-900">
      Productos ({productosFiltrados.length}{productosFiltrados.length !== (productos?.length ?? 0) ? ` de ${productos?.length ?? 0}` : ""})
    </h1>
    <a href="/admin/productos/nuevo" class="rounded-md bg-brand-500 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-400">
      + Nuevo producto
    </a>
  </div>

  {resultadoEliminar?.error && (
    <p class="mb-4 text-sm text-red-600">{resultadoEliminar.error.message}</p>
  )}

  <form method="GET" class="mb-4 flex flex-wrap items-end gap-3">
    <div>
      <label for="buscador" class="mb-1 block text-xs font-medium text-slate-500">Buscar</label>
      <input
        id="buscador"
        type="search"
        placeholder="Nombre o SKU..."
        onkeydown="if (event.key === 'Enter') event.preventDefault()"
        class="w-full max-w-xs rounded-md border border-slate-300 px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-brand-500"
      />
    </div>

    <div>
      <label for="filtro-categoria" class="mb-1 block text-xs font-medium text-slate-500">Categoría</label>
      <select
        id="filtro-categoria"
        name="categoria"
        onchange="this.form.submit()"
        class="rounded-md border border-slate-300 px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-brand-500"
      >
        <option value="">Todas</option>
        {(categorias ?? []).map((c) => (
          <option value={c.id} selected={c.id === categoriaSeleccionada}>{c.nombre}</option>
        ))}
      </select>
    </div>

    <div>
      <label for="filtro-orden" class="mb-1 block text-xs font-medium text-slate-500">Ordenar por</label>
      <select
        id="filtro-orden"
        name="orden"
        onchange="this.form.submit()"
        class="rounded-md border border-slate-300 px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-brand-500"
      >
        <option value="alerta" selected={orden === "alerta"}>Alerta de stock primero</option>
        <option value="rotacion" selected={orden === "rotacion"}>Menor stock primero (rotación)</option>
        <option value="nombre" selected={orden === "nombre"}>Nombre A-Z</option>
      </select>
    </div>

    {categoriaSeleccionada && (
      <a href="/admin" class="pb-2 text-sm text-slate-500 hover:text-red-600">Quitar filtro de categoría</a>
    )}
  </form>

  <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
    <table class="w-full text-left text-sm">
      <thead class="border-b border-slate-200 bg-slate-50 text-xs uppercase text-slate-500">
        <tr>
          <th class="px-4 py-3">Foto</th>
          <th class="px-4 py-3">SKU</th>
          <th class="px-4 py-3">Nombre</th>
          <th class="px-4 py-3">Categoría</th>
          <th class="px-4 py-3">Precio</th>
          <th class="px-4 py-3">Stock</th>
          <th class="px-4 py-3">Estado</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody>
        {productosOrdenados.map((p) => {
          const estado = estadoStock(p.stock);
          const imagenes = p.imagenes as unknown as { url: string; es_principal: boolean; orden: number }[];
          const imagenPrincipal = imagenes.find((img) => img.es_principal) ?? imagenes[0];
          return (
            <tr
              data-fila-producto
              data-busqueda={`${p.nombre} ${p.sku}`.toLowerCase()}
              class="border-b border-slate-100 last:border-0"
            >
              <td class="px-4 py-3">
                <div class="flex h-12 w-12 items-center justify-center overflow-hidden rounded-md border border-slate-100 bg-white">
                  {imagenPrincipal ? (
                    <img src={imagenPrincipal.url} alt={p.nombre} class="h-full w-full object-contain" loading="lazy" />
                  ) : (
                    <span class="text-[9px] text-slate-400">Sin foto</span>
                  )}
                </div>
              </td>
              <td class="px-4 py-3 text-slate-500">{p.sku}</td>
              <td class="px-4 py-3 font-medium text-slate-900">{p.nombre}</td>
              <td class="px-4 py-3 text-slate-500">{(p.categoria as unknown as { nombre: string } | null)?.nombre ?? "—"}</td>
              <td class="px-4 py-3">{formatearPrecio(p.precio)}</td>
              <td class="px-4 py-3">
                <span class:list={[
                  "font-medium",
                  estado === "agotado" && "text-red-600",
                  estado === "bajo" && "text-amber-600",
                  estado === "ok" && "text-slate-700",
                ]}>
                  {p.stock}
                </span>
                {estado === "bajo" && (
                  <span class="ml-2 rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-700">Stock bajo</span>
                )}
                {estado === "agotado" && (
                  <span class="ml-2 rounded-full bg-red-100 px-2 py-0.5 text-xs font-medium text-red-700">Agotado</span>
                )}
              </td>
              <td class="px-4 py-3">
                {p.activo ? (
                  <span class="rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-700">Activo</span>
                ) : (
                  <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-500">Oculto</span>
                )}
              </td>
              <td class="px-4 py-3">
                <div class="flex items-center justify-end gap-1.5 whitespace-nowrap">
                  <a
                    href={`/admin/productos/${p.id}`}
                    title="Editar producto"
                    class="flex items-center gap-1 rounded-md border border-slate-200 px-2.5 py-1.5 text-xs font-medium text-slate-600 hover:border-brand-300 hover:bg-brand-50 hover:text-brand-700"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M12 20h9" />
                      <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />
                    </svg>
                    Editar
                  </a>
                  <a
                    href={`/admin/productos/${p.id}#variantes`}
                    title="Ir al stock por variante"
                    class="flex items-center gap-1 rounded-md border border-slate-200 px-2.5 py-1.5 text-xs font-medium text-slate-600 hover:border-slate-300 hover:bg-slate-50"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M21 8V6a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 6v6a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0" />
                      <path d="M3.27 6.96 12 12l8.73-5.04" />
                      <path d="M12 22.08V12" />
                      <path d="M18 15v6" />
                      <path d="M15 18h6" />
                    </svg>
                    Stock
                  </a>
                  <form method="POST" action={actions.eliminarProductoDefinitivo} data-form-eliminar-definitivo>
                    <input type="hidden" name="id" value={p.id} />
                    <button
                      type="submit"
                      title="Eliminar producto"
                      class="flex items-center gap-1 rounded-md border border-red-200 px-2.5 py-1.5 text-xs font-medium text-red-600 hover:bg-red-50"
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M3 6h18" />
                        <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                        <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                        <path d="M10 11v6" />
                        <path d="M14 11v6" />
                      </svg>
                      Eliminar
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
</AdminLayout>

<script>
  const input = document.getElementById("buscador") as HTMLInputElement | null;
  const filas = document.querySelectorAll<HTMLElement>("[data-fila-producto]");

  input?.addEventListener("input", () => {
    const q = input.value.trim().toLowerCase();
    filas.forEach((fila) => {
      const coincide = fila.dataset.busqueda?.includes(q) ?? true;
      fila.style.display = coincide ? "" : "none";
    });
  });

  document.querySelectorAll("[data-form-eliminar-definitivo]").forEach((form) => {
    form.addEventListener("submit", (e) => {
      const ok = confirm(
        "Esto borra el producto para siempre (incluidas sus imágenes, variantes y reseñas). No se puede deshacer. ¿Continuar?"
      );
      if (!ok) e.preventDefault();
    });
  });
</script>
