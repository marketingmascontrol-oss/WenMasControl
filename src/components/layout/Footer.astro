---
import { SITE } from "../../lib/site";
import type { Categoria } from "../../../types/product";

interface Props {
  categorias: Categoria[];
}

const { categorias } = Astro.props;
const anioActual = new Date().getFullYear();

// Una red sin URL todavía se muestra como "próximamente", nunca como un enlace
// roto: un comprador que toca Instagram y no llega a nada desconfía del resto.
const redes = [
  { nombre: "Instagram", url: SITE.redes.instagram },
  { nombre: "Facebook", url: SITE.redes.facebook },
  { nombre: "LinkedIn", url: SITE.redes.linkedin },
  { nombre: "TikTok", url: SITE.redes.tiktok },
];
---

<footer class="bg-brand-500 text-[#AEB4C4]">
  <div class="franja-plata" aria-hidden="true"></div>
  <div class="mx-auto max-w-7xl px-4 pb-10 pt-14">
    <div class="grid gap-10 lg:grid-cols-[1.3fr_1fr_1fr_1fr]">
      <div>
        <img src={SITE.logoNegativo} alt={SITE.nombre} class="h-12 w-auto" width="137" height="48" />
        <p class="mt-5 max-w-xs text-[15px]">{SITE.descripcion}</p>
        {SITE.direccion && <p class="mt-3 text-sm text-[#8B92A8]">{SITE.direccion}</p>}
        <ul class="mt-5 flex flex-wrap gap-x-4 gap-y-2 text-sm">
          {redes.map((r) => (
            <li>
              {r.url ? (
                <a href={r.url} target="_blank" rel="noopener noreferrer" class="font-semibold text-white hover:text-plata">{r.nombre}</a>
              ) : (
                <span class="text-[#7C869A]" title="Próximamente">{r.nombre} (próx.)</span>
              )}
            </li>
          ))}
        </ul>
      </div>

      <nav aria-label="Categorías">
        <h2 class="text-sm font-bold text-white">Catálogo</h2>
        <ul class="mt-4 space-y-2 text-sm">
          {categorias.map((categoria) => (
            <li><a href={`/categorias/${categoria.slug}`} class="hover:text-white">{categoria.nombre}</a></li>
          ))}
        </ul>
      </nav>

      <div>
        <h2 class="text-sm font-bold text-white">Contacto</h2>
        <ul class="mt-4 space-y-2 text-sm">
          {SITE.telefono && <li><a href={`tel:${SITE.telefonoTel}`} class="hover:text-white">{SITE.telefono}</a></li>}
          {SITE.email && <li><a href={`mailto:${SITE.email}`} class="break-all hover:text-white">{SITE.email}</a></li>}
          <li><a href="/cotizar" class="hover:text-white">Cotizar por volumen</a></li>
          <li><a href="/contacto" class="hover:text-white">Contacto</a></li>
          <li><a href="/preguntas-frecuentes" class="hover:text-white">Preguntas frecuentes</a></li>
        </ul>
      </div>

      <div>
        <h2 class="text-sm font-bold text-white">Empresa</h2>
        <ul class="mt-4 space-y-2 text-sm">
          <li>Facturación electrónica con NIT</li>
          <li>Asesoría técnica en EPP</li>
          <li><a href="/proveedores" class="hover:text-white">¿Quiere ser proveedor?</a></li>
          <li><a href="/politica-tratamiento-datos" class="hover:text-white">Política de tratamiento de datos</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-3 border-t border-white/10 pt-6 text-xs text-[#7C869A] sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {anioActual} {SITE.razonSocial}. Todos los derechos reservados.</p>
      <p>
        Hecho por <a href="https://socialicons.co" target="_blank" rel="noopener noreferrer" class="hover:text-white">Social Icons</a>
        · Asesor virtual <a href="https://www.arkco360.com" target="_blank" rel="noopener noreferrer" class="hover:text-white">Arkco360</a>
      </p>
    </div>
  </div>
</footer>
