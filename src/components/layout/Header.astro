---
import { SITE } from "../../lib/site";
import { formatearPrecio } from "../../lib/formato";
import type { Categoria } from "../../../types/product";

interface Props {
  categorias: Categoria[];
}

const { categorias } = Astro.props;
const rutaActual = Astro.url.pathname;
---

{/* Header +Control: un plano Azul Mando con el logo en negativo y la franja
    plata como borde inferior (manual, «Aplicaciones»). Las categorías van a la
    vista en una fila y no escondidas en un menú: en EPP el comprador llega
    pensando en una parte del cuerpo —manos, cabeza, pies— y la tiene que ver. */}
<header class="sticky top-0 z-50">
  <div class="bg-brand-500 text-white">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-6 gap-y-3 px-4 py-3 lg:flex-nowrap">
      <a href="/" class="shrink-0" aria-label={`${SITE.nombre}, inicio`}>
        <img src={SITE.logoNegativo} alt={SITE.nombre} class="h-9 w-auto sm:h-11" width="141" height="49" />
      </a>

      <div class="order-last w-full lg:order-none lg:flex-1">
        <div class="relative mx-auto w-full max-w-2xl">
          <form action="/buscar" method="get" role="search" autocomplete="off">
            <label for="buscador" class="sr-only">Buscar productos EPP</label>
            <div class="flex overflow-hidden rounded-[6px] bg-white focus-within:ring-2 focus-within:ring-plata">
              <span class="flex items-center pl-3 text-acero" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="11" cy="11" r="7" />
                  <path d="m21 21-4.3-4.3" />
                </svg>
              </span>
              <input
                id="buscador"
                name="q"
                type="search"
                placeholder="¿Qué necesita proteger? Manos, cabeza, alturas…"
                class="w-full px-3 py-2.5 text-[15px] text-brand-500 placeholder:text-acero/80 outline-none"
              />
              <button type="submit" class="hidden bg-tecnico px-4 text-sm font-semibold text-brand-500 hover:bg-linea sm:block">
                Buscar
              </button>
            </div>
          </form>
          <p class="mt-1 hidden text-right text-[10px] font-medium tracking-wide text-plata/70 lg:block">
            Búsqueda inteligente · Arkco360
          </p>
          <div
            id="sugerencias-busqueda"
            class="absolute left-0 right-0 top-full z-40 mt-1 hidden max-h-96 overflow-y-auto rounded-[6px] border border-linea bg-white text-brand-500 shadow-xl"
          ></div>
        </div>
      </div>

      <div class="ml-auto flex shrink-0 items-center gap-1 sm:gap-2">
        {SITE.telefono && (
          <a href={`tel:${SITE.telefonoTel}`} class="mr-2 hidden text-sm font-semibold text-plata hover:text-white xl:block">
            {SITE.telefono}
          </a>
        )}
        <a href="/favoritos" class="relative rounded-[6px] p-2 text-plata hover:bg-white/10 hover:text-white" aria-label="Ver favoritos">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M12 20.5s-7-4.35-9.5-8.7C.8 8.6 2 5 5.3 4.2c2-.5 3.9.4 4.7 2 .8-1.6 2.7-2.5 4.7-2 3.3.8 4.5 4.4 2.8 7.6-2.5 4.35-9.5 8.7-9.5 8.7z" />
          </svg>
          <span id="contador-favoritos" class="absolute right-0 top-0 flex h-4 min-w-4 items-center justify-center rounded-full bg-white px-1 text-[10px] font-bold text-brand-500">0</span>
        </a>
        <button type="button" id="boton-abrir-carrito" class="relative flex items-center gap-2 rounded-[6px] p-2 text-plata hover:bg-white/10 hover:text-white" aria-label="Ver carrito">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M6 7h12l-1 13H7L6 7Z" />
            <path d="M9 7a3 3 0 0 1 6 0" />
          </svg>
          {/* El único rojo del header: un contador es una señal, que es
              justo para lo que el manual reserva el Rojo Señal. */}
          <span id="contador-carrito" class="absolute right-0 top-0 flex h-4 min-w-4 items-center justify-center rounded-full bg-senal px-1 text-[10px] font-bold text-white">0</span>
        </button>
        <a
          href="/cotizar"
          class="ml-2 hidden items-center rounded-[6px] bg-white px-4 py-2 text-sm font-bold text-brand-500 transition hover:bg-plata md:inline-flex"
        >
          Cotizar por volumen
        </a>
      </div>
    </div>
  </div>
  <div class="h-[6px] bg-plata" aria-hidden="true"></div>

  <nav aria-label="Categorías" class="border-b border-linea bg-white/95 backdrop-blur">
    <div class="mx-auto flex max-w-7xl items-center gap-1 px-4">
      <div class="relative shrink-0">
        <button
          type="button"
          id="boton-categorias"
          aria-haspopup="true"
          aria-expanded="false"
          class="flex items-center gap-2 py-3 pr-3 text-sm font-bold text-brand-500"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2">
            <path d="M4 6h16M4 12h10M4 18h16" />
          </svg>
          Catálogo
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" id="chevron-categorias" class="transition-transform">
            <path d="m6 9 6 6 6-6" />
          </svg>
        </button>
        <div
          id="panel-categorias"
          class="absolute left-0 top-full z-40 hidden w-72 overflow-hidden rounded-[6px] border border-linea bg-white py-2 shadow-xl"
        >
          <a href="/categorias" class="block px-4 py-2 text-sm font-semibold text-brand-500 hover:bg-tecnico">Todo el catálogo</a>
          <div class="my-1 border-t border-linea"></div>
          {categorias.map((categoria) => (
            <a href={`/categorias/${categoria.slug}`} class="block px-4 py-2 text-sm text-acero hover:bg-tecnico hover:text-brand-500">
              {categoria.nombre}
            </a>
          ))}
        </div>
      </div>

      <span class="h-5 w-px shrink-0 bg-linea" aria-hidden="true"></span>

      <ul class="flex min-w-0 flex-1 items-center gap-1 overflow-x-auto whitespace-nowrap py-2 text-sm [scrollbar-width:none]">
        <li>
          <a href="/promociones" class="flex items-center gap-1.5 rounded-[6px] px-3 py-1.5 font-semibold text-brand-500 hover:bg-tecnico">
            <span class="h-1.5 w-1.5 rounded-full bg-senal" aria-hidden="true"></span>
            Promociones
          </a>
        </li>
        {categorias.filter((c) => c.slug !== "promociones").map((categoria) => {
          const activa = rutaActual === `/categorias/${categoria.slug}`;
          return (
            <li>
              <a
                href={`/categorias/${categoria.slug}`}
                class:list={[
                  "block rounded-[6px] px-3 py-1.5 transition",
                  activa ? "bg-brand-500 font-semibold text-white" : "text-acero hover:bg-tecnico hover:text-brand-500",
                ]}
              >
                {categoria.nombre.replace(/^Protección (de |)/i, "")}
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </nav>
</header>

<script>
  import { buscar } from "../../lib/buscador-arkco";
  import { formatearPrecio } from "../../lib/formato";

  document.getElementById("boton-abrir-carrito")?.addEventListener("click", () => {
    window.dispatchEvent(new CustomEvent("abrir-carrito"));
  });

  // Autosugerencias del buscador (usa /api/search, la misma que consulta Arkco360)
  interface ResultadoBusqueda {
    slug: string;
    nombre: string;
    precio: number;
    imagen: string | null;
  }

  const inputBuscador = document.getElementById("buscador") as HTMLInputElement | null;
  const sugerenciasEl = document.getElementById("sugerencias-busqueda");
  let temporizador: ReturnType<typeof setTimeout> | undefined;
  let controlador: AbortController | undefined;

  function ocultarSugerencias() {
    sugerenciasEl?.classList.add("hidden");
    if (sugerenciasEl) sugerenciasEl.innerHTML = "";
  }

  function crearFilaSugerencia(r: ResultadoBusqueda): HTMLElement {
    const enlace = document.createElement("a");
    enlace.href = `/productos/${r.slug}`;
    enlace.className = "flex items-center gap-3 px-3 py-2 hover:bg-tecnico";

    const miniatura = document.createElement("span");
    miniatura.className =
      "flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-md border border-slate-100 bg-white";
    if (r.imagen) {
      const img = document.createElement("img");
      img.src = r.imagen;
      img.alt = "";
      img.className = "h-full w-full object-contain";
      miniatura.appendChild(img);
    }

    const info = document.createElement("span");
    info.className = "min-w-0 flex-1";
    const nombreEl = document.createElement("span");
    nombreEl.className = "block truncate text-sm text-slate-800";
    nombreEl.textContent = r.nombre;
    const precioEl = document.createElement("span");
    precioEl.className = "block text-xs font-semibold text-slate-500";
    precioEl.textContent = formatearPrecio(r.precio);
    info.append(nombreEl, precioEl);

    enlace.append(miniatura, info);
    return enlace;
  }

  function renderSugerencias(resultados: ResultadoBusqueda[]) {
    if (!sugerenciasEl) return;
    if (resultados.length === 0) {
      ocultarSugerencias();
      return;
    }
    sugerenciasEl.replaceChildren(...resultados.slice(0, 6).map(crearFilaSugerencia));
    sugerenciasEl.classList.remove("hidden");
  }

  inputBuscador?.addEventListener("input", () => {
    const q = inputBuscador.value.trim();
    clearTimeout(temporizador);
    if (q.length < 2) {
      ocultarSugerencias();
      return;
    }
    temporizador = setTimeout(async () => {
      controlador?.abort();
      controlador = new AbortController();
      try {
        // Las sugerencias pasan por Arkco: quien escribe «oídos» tiene que ver
        // protectores auditivos, no un casco. Si Arkco no responde a tiempo,
        // `buscar` cae sola al buscador de siempre.
        const { productos } = await buscar(q, controlador.signal);
        renderSugerencias(productos);
      } catch {
        // ignorar (petición cancelada por una más nueva, o de red)
      }
    }, 250);
  });

  document.addEventListener("click", (e) => {
    if (sugerenciasEl && !sugerenciasEl.contains(e.target as Node) && e.target !== inputBuscador) {
      ocultarSugerencias();
    }
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") ocultarSugerencias();
  });

  const botonCategorias = document.getElementById("boton-categorias");
  const panelCategorias = document.getElementById("panel-categorias");
  const chevron = document.getElementById("chevron-categorias");

  function cerrarPanelCategorias() {
    panelCategorias?.classList.add("hidden");
    chevron?.classList.remove("rotate-180");
    botonCategorias?.setAttribute("aria-expanded", "false");
  }

  botonCategorias?.addEventListener("click", (e) => {
    e.stopPropagation();
    const abierto = !panelCategorias?.classList.contains("hidden");
    if (abierto) {
      cerrarPanelCategorias();
    } else {
      panelCategorias?.classList.remove("hidden");
      chevron?.classList.add("rotate-180");
      botonCategorias.setAttribute("aria-expanded", "true");
    }
  });

  document.addEventListener("click", (e) => {
    if (panelCategorias && !panelCategorias.classList.contains("hidden") && !panelCategorias.contains(e.target as Node)) {
      cerrarPanelCategorias();
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") cerrarPanelCategorias();
  });
</script>
