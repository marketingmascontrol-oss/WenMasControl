---
import { actions } from "astro:actions";
import Estrellas from "../ui/Estrellas.astro";
import type { Resena, ResumenResenas } from "../../../types/product";

interface Props {
  productoId: string;
  resenas: Resena[];
  resumen: ResumenResenas;
}

const { productoId, resenas, resumen } = Astro.props;

const resultado = Astro.getActionResult(actions.crearResena);
const enviadaOk = Boolean(resultado && !resultado.error);

function formatearFecha(iso: string): string {
  return new Date(iso).toLocaleDateString("es-CO", { year: "numeric", month: "long", day: "numeric" });
}
---

{/* Las reseñas en dos columnas: el resumen y el formulario (plegado, que no
    le gane espacio a la compra) a la izquierda; lo que dicen, a la derecha. */}
<section id="resenas" class="grid gap-8 border-t border-linea pt-12 lg:grid-cols-[320px_1fr] lg:gap-12">
  <div>
    <h2 class="text-2xl font-black tracking-[-0.03em] text-brand-500">Lo que dicen quienes lo usan</h2>
    <div class="mt-3"><Estrellas promedio={resumen.promedio} total={resumen.total} tamano="md" /></div>

    {enviadaOk && (
      <p class="mt-4 rounded-[6px] bg-green-50 px-3 py-2 text-sm text-green-700">
        ¡Gracias! Su reseña quedó pendiente de aprobación y se publicará pronto.
      </p>
    )}
    {resultado?.error && (
      <p class="mt-4 rounded-[6px] bg-red-50 px-3 py-2 text-sm text-red-700">{resultado.error.message}</p>
    )}

    <details class="group mt-5 rounded-[6px] border border-linea" open={Boolean(resultado?.error)}>
      <summary class="flex cursor-pointer list-none items-center justify-between px-4 py-3 text-sm font-bold text-brand-500">
        Escribir una reseña
        <span class="transition group-open:rotate-45" aria-hidden="true">+</span>
      </summary>
      <form method="POST" action={actions.crearResena} class="space-y-3 border-t border-linea p-4">
        <input type="hidden" name="producto_id" value={productoId} />
        <div>
          <label class="block text-xs font-semibold text-acero">Su nombre</label>
          <input
            name="autor_nombre"
            required
            maxlength="80"
            class="mt-1 w-full rounded-[6px] border border-linea px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-brand-500"
          />
        </div>
        <div>
          <label class="block text-xs font-semibold text-acero">Calificación</label>
          <select name="calificacion" required class="mt-1 w-full rounded-[6px] border border-linea px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-brand-500">
            <option value="5">5 - Excelente</option>
            <option value="4">4 - Muy bueno</option>
            <option value="3">3 - Bueno</option>
            <option value="2">2 - Regular</option>
            <option value="1">1 - Malo</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-acero">Comentario (opcional)</label>
          <textarea
            name="comentario"
            rows="3"
            maxlength="1000"
            class="mt-1 w-full rounded-[6px] border border-linea px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-brand-500"
          ></textarea>
        </div>
        <button type="submit" class="rounded-[6px] bg-brand-500 px-5 py-2.5 text-sm font-bold text-white hover:bg-brand-400">
          Enviar reseña
        </button>
      </form>
    </details>
  </div>

  {resenas.length > 0 ? (
    <ul class="grid gap-4 sm:grid-cols-2">
      {resenas.map((resena) => (
        <li class="rounded-[6px] bg-tecnico p-5">
          <Estrellas promedio={resena.calificacion} total={1} />
          {resena.comentario && <p class="mt-3 text-[15px] text-brand-500">«{resena.comentario}»</p>}
          <p class="mt-3 text-[13px] font-bold text-brand-500">{resena.autor_nombre}</p>
          <p class="text-xs text-acero">{formatearFecha(resena.created_at)}</p>
        </li>
      ))}
    </ul>
  ) : (
    <div class="flex items-center rounded-[6px] bg-tecnico p-6 text-[15px] text-acero">
      Todavía no hay reseñas de este producto. Si ya lo usó, cuéntele a otros compradores cómo le fue.
    </div>
  )}
</section>
