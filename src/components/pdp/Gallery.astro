---
import type { ProductoImagen } from "../../../types/product";

interface Props {
  imagenes: ProductoImagen[];
  nombre: string;
}

// La foto sobre Blanco Técnico (no sobre blanco con borde, como en Wincol), con
// las miniaturas en fila debajo: el producto de dotación se mira entero, no
// hace falta la columna lateral.
const { imagenes, nombre } = Astro.props;
const ordenadas = [...imagenes].sort((a, b) => a.orden - b.orden);
const principal = ordenadas[0];
---

<div data-galeria>
  <div class="relative flex aspect-[5/4] items-center justify-center overflow-hidden rounded-[6px] bg-tecnico">
    {principal ? (
      <img
        data-imagen-principal
        src={principal.url}
        alt={principal.alt ?? nombre}
        class="h-full w-full object-contain p-8 mix-blend-multiply sm:p-12"
      />
    ) : (
      <img src="/simbolo-color.svg" alt="" class="h-24 w-24 opacity-20" />
    )}
    <span class="absolute inset-x-0 bottom-0 h-[3px] bg-plata" aria-hidden="true"></span>
  </div>

  {ordenadas.length > 1 && (
    <ul class="mt-3 flex gap-2 overflow-x-auto">
      {ordenadas.map((img, i) => (
        <li class="shrink-0">
          <button
            type="button"
            data-miniatura
            data-src={img.url}
            data-alt={img.alt ?? nombre}
            aria-label={`Ver imagen ${i + 1} de ${nombre}`}
            class="h-20 w-20 overflow-hidden rounded-[6px] border-2 border-transparent bg-tecnico p-1.5 hover:border-plata aria-current:border-brand-500"
            aria-current={i === 0 ? "true" : "false"}
          >
            <img src={img.url} alt="" loading="lazy" class="h-full w-full object-contain mix-blend-multiply" />
          </button>
        </li>
      ))}
    </ul>
  )}
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-galeria]").forEach((galeria) => {
    const imagenPrincipal = galeria.querySelector<HTMLImageElement>("[data-imagen-principal]");
    const miniaturas = galeria.querySelectorAll<HTMLButtonElement>("[data-miniatura]");

    miniaturas.forEach((miniatura) => {
      miniatura.addEventListener("click", () => {
        if (!imagenPrincipal) return;
        imagenPrincipal.src = miniatura.dataset.src ?? imagenPrincipal.src;
        imagenPrincipal.alt = miniatura.dataset.alt ?? imagenPrincipal.alt;
        miniaturas.forEach((m) => m.setAttribute("aria-current", "false"));
        miniatura.setAttribute("aria-current", "true");
      });
    });
  });
</script>
