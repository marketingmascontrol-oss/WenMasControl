---
import type { ProductoConRelaciones } from "../../../types/product";
import ProductCard from "../ui/ProductCard.astro";
import { obtenerResumenResenasPorProductos } from "../../lib/resenas";

interface Props {
  productos: ProductoConRelaciones[];
}

const { productos } = Astro.props;
const resumenPorProducto = await obtenerResumenResenasPorProductos(productos.map((p) => p.id));
---

{productos.length > 0 && (
  <section class="mt-16">
    <h2 class="mb-6 text-2xl font-black tracking-[-0.03em] text-brand-500">Para completar la dotación</h2>
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-5 lg:grid-cols-4">
      {productos.map((producto) => (
        <ProductCard producto={producto} resumenResenas={resumenPorProducto.get(producto.id)} />
      ))}
    </div>
  </section>
)}
