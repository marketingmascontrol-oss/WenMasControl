---
interface ItemBreadcrumb {
  nombre: string;
  url: string;
}

interface Props {
  items: ItemBreadcrumb[];
}

const { items } = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: items.map((item, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: item.nombre,
    item: item.url,
  })),
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
