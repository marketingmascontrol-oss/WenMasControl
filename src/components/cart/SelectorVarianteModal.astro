<!--
  Modal único global (montado en BaseLayout, igual que CarritoDrawer) para
  elegir talla/color sin salir de la grilla de productos, estilo Temu.
  ProductCard dispara el evento "abrir-selector-variante" con los datos del
  producto (ver listener delegado en BaseLayout.astro).
-->
<div id="selector-variante-modal" class="fixed inset-0 z-[70] hidden">
  <div
    id="selector-variante-backdrop"
    class="absolute inset-0 bg-slate-900/50 opacity-0 transition-opacity duration-300"
  ></div>

  <div class="absolute inset-0 flex items-end justify-center sm:items-center sm:p-4">
    <div
      id="selector-variante-panel"
      data-cantidad-scope
      class="w-full max-w-md translate-y-full rounded-t-2xl bg-white p-5 shadow-xl transition-transform duration-300 ease-out sm:rounded-2xl"
      role="dialog"
      aria-modal="true"
      aria-label="Elegir talla y color"
    >
      <div class="flex items-start justify-between gap-3">
        <div class="flex items-center gap-3">
          <div class="flex h-16 w-16 shrink-0 items-center justify-center overflow-hidden rounded-md border border-slate-100 bg-white">
            <img id="selector-variante-imagen" src="" alt="" class="hidden h-full w-full object-contain" />
          </div>
          <div class="min-w-0">
            <p id="selector-variante-nombre" class="line-clamp-2 text-sm font-medium text-slate-900"></p>
            <p id="selector-variante-precio" class="mt-0.5 text-lg font-bold text-slate-900"></p>
          </div>
        </div>
        <button
          type="button"
          id="selector-variante-cerrar"
          aria-label="Cerrar"
          class="shrink-0 text-slate-400 hover:text-slate-700"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 6 6 18M6 6l12 12" />
          </svg>
        </button>
      </div>

      <div class="mt-5">
        <p class="text-sm font-medium text-slate-700">Talla</p>
        <div id="selector-variante-tallas" class="mt-2 flex flex-wrap gap-2"></div>
      </div>

      <div class="mt-4">
        <p class="text-sm font-medium text-slate-700">Color</p>
        <div id="selector-variante-colores" class="mt-2 flex flex-wrap gap-2"></div>
      </div>

      <p id="selector-variante-disponibilidad" class="mt-4 text-sm font-medium text-slate-500"></p>

      <div class="mt-2 flex w-32 items-center rounded-md border border-slate-300">
        <button type="button" data-restar aria-label="Restar cantidad" class="px-3 py-2 text-lg text-slate-600 hover:text-slate-900">−</button>
        <input
          id="selector-variante-cantidad"
          data-cantidad
          type="number"
          min="1"
          value="1"
          inputmode="numeric"
          class="w-full border-x border-slate-300 py-2 text-center text-sm outline-none"
        />
        <button type="button" data-sumar aria-label="Sumar cantidad" class="px-3 py-2 text-lg text-slate-600 hover:text-slate-900">+</button>
      </div>

      <button
        type="button"
        id="selector-variante-agregar"
        data-agregar-carrito
        disabled
        class="mt-4 w-full rounded-md bg-brand-500 py-3 text-sm font-semibold text-white hover:bg-brand-400 disabled:cursor-not-allowed disabled:bg-slate-200 disabled:text-slate-400"
      >
        Agregar al carrito
      </button>
    </div>
  </div>
</div>

<script>
  import type { ProductoVariante } from "../../../types/product";
  import { tallasDisponibles, coloresDisponibles, coloresParaTalla, buscarVariante } from "../../lib/variantes";
  import { formatearPrecio } from "../../lib/formato";
  import { colorCss } from "../../lib/colores";

  interface ProductoParaSelector {
    sku: string;
    nombre: string;
    precio: number;
    imagen?: string;
    variantes: ProductoVariante[];
  }

  const modal = document.getElementById("selector-variante-modal")!;
  const backdrop = document.getElementById("selector-variante-backdrop")!;
  const panel = document.getElementById("selector-variante-panel")!;
  const imagenEl = document.getElementById("selector-variante-imagen") as HTMLImageElement;
  const nombreEl = document.getElementById("selector-variante-nombre")!;
  const precioEl = document.getElementById("selector-variante-precio")!;
  const tallasEl = document.getElementById("selector-variante-tallas")!;
  const coloresEl = document.getElementById("selector-variante-colores")!;
  const disponibilidadEl = document.getElementById("selector-variante-disponibilidad")!;
  const cantidadInput = document.getElementById("selector-variante-cantidad") as HTMLInputElement;
  const botonAgregar = document.getElementById("selector-variante-agregar") as HTMLButtonElement;

  const claseOpcion =
    "rounded-md border border-slate-300 px-3 py-1.5 text-sm text-slate-700 hover:border-slate-400 disabled:cursor-not-allowed disabled:border-slate-100 disabled:text-slate-300";
  const claseOpcionActiva = "border-brand-500 bg-brand-50 text-brand-700 hover:border-brand-500";

  const claseSwatch =
    "h-9 w-9 rounded-full border-2 border-slate-300 transition hover:border-slate-400 disabled:cursor-not-allowed disabled:opacity-40";
  const claseSwatchActiva = "border-brand-500 ring-2 ring-offset-2 ring-brand-500";

  // Swatch de color (círculo) cuando se reconoce el color; si no (ej. "Único"),
  // se cae a un botón de texto para no mostrar un círculo sin sentido.
  function crearBotonColor(color: string): HTMLButtonElement {
    const boton = document.createElement("button");
    boton.type = "button";
    boton.dataset.color = color;
    boton.title = color;
    boton.setAttribute("aria-label", color);

    const css = colorCss(color);
    if (css) {
      boton.className = claseSwatch;
      boton.style.backgroundColor = css;
    } else {
      boton.textContent = color;
      boton.className = claseOpcion;
    }
    return boton;
  }

  let productoActual: ProductoParaSelector | null = null;
  let tallaSeleccionada: string | null = null;
  let colorSeleccionado: string | null = null;

  function varianteActiva(): ProductoVariante | undefined {
    if (!productoActual || !tallaSeleccionada || !colorSeleccionado) return undefined;
    return buscarVariante(productoActual.variantes, tallaSeleccionada, colorSeleccionado);
  }

  function clamp(valor: number): number {
    const max = Number(cantidadInput.max) || 1;
    return Math.min(Math.max(valor, 1), max);
  }

  function renderTallas() {
    if (!productoActual) return;
    tallasEl.replaceChildren(
      ...tallasDisponibles(productoActual.variantes).map((talla) => {
        const sinStock = coloresParaTalla(productoActual!.variantes, talla).length === 0;
        const boton = document.createElement("button");
        boton.type = "button";
        boton.textContent = talla;
        boton.className = claseOpcion;
        boton.disabled = sinStock;
        boton.addEventListener("click", () => {
          tallaSeleccionada = talla;
          // si el color ya elegido no aplica para esta talla, se limpia
          if (colorSeleccionado) {
            const v = buscarVariante(productoActual!.variantes, tallaSeleccionada, colorSeleccionado);
            if (!v || v.stock <= 0) colorSeleccionado = null;
          }
          actualizarEstado();
        });
        return boton;
      })
    );
  }

  // Los colores se muestran todos de entrada (no solo tras elegir talla):
  // antes quedaban ocultos hasta el primer clic en talla, lo que parecía un
  // selector roto para productos con varias tallas.
  function renderColores() {
    if (!productoActual) return;
    coloresEl.replaceChildren(
      ...coloresDisponibles(productoActual.variantes).map((color) => {
        const boton = crearBotonColor(color);
        boton.addEventListener("click", () => {
          if (boton.disabled) return;
          colorSeleccionado = color;
          actualizarEstado();
        });
        return boton;
      })
    );
  }

  function actualizarEstado() {
    tallasEl.querySelectorAll<HTMLButtonElement>("button").forEach((boton) => {
      boton.className = `${claseOpcion} ${boton.textContent === tallaSeleccionada ? claseOpcionActiva : ""}`.trim();
    });
    coloresEl.querySelectorAll<HTMLButtonElement>("button").forEach((boton) => {
      const color = boton.dataset.color ?? "";
      const activo = color === colorSeleccionado;
      // sin talla elegida todavía, no se deshabilita ningún color (el
      // cliente puede empezar por cualquiera de los dos selectores)
      const sinStockParaTalla =
        tallaSeleccionada !== null &&
        (buscarVariante(productoActual!.variantes, tallaSeleccionada, color)?.stock ?? 0) <= 0;
      boton.disabled = sinStockParaTalla;
      const esSwatch = !!colorCss(color);
      boton.className = esSwatch
        ? `${claseSwatch} ${activo ? claseSwatchActiva : ""}`.trim()
        : `${claseOpcion} ${activo ? claseOpcionActiva : ""}`.trim();
    });

    const variante = varianteActiva();

    if (variante && variante.stock > 0) {
      disponibilidadEl.textContent = `En stock (${variante.stock} disponibles)`;
      cantidadInput.max = String(variante.stock);
      cantidadInput.value = String(clamp(Number(cantidadInput.value) || 1));
      botonAgregar.disabled = false;
      botonAgregar.dataset.varianteId = variante.id;
      botonAgregar.dataset.talla = tallaSeleccionada!;
      botonAgregar.dataset.color = colorSeleccionado!;
      botonAgregar.dataset.sku = productoActual!.sku;
      botonAgregar.dataset.nombre = productoActual!.nombre;
      botonAgregar.dataset.precio = String(productoActual!.precio);
      if (productoActual!.imagen) botonAgregar.dataset.imagen = productoActual!.imagen;
    } else {
      disponibilidadEl.textContent = tallaSeleccionada && colorSeleccionado
        ? "Agotado en esta combinación"
        : "Elige talla y color";
      botonAgregar.disabled = true;
      delete botonAgregar.dataset.varianteId;
    }
  }

  function abrir(producto: ProductoParaSelector) {
    productoActual = producto;
    tallaSeleccionada = null;
    colorSeleccionado = null;
    cantidadInput.value = "1";

    nombreEl.textContent = producto.nombre;
    precioEl.textContent = formatearPrecio(producto.precio);
    if (producto.imagen) {
      imagenEl.src = producto.imagen;
      imagenEl.alt = producto.nombre;
      imagenEl.classList.remove("hidden");
    } else {
      imagenEl.classList.add("hidden");
    }

    renderTallas();
    renderColores();
    // 🔴 13/08/2026 — MISMO BUG QUE EN LA FICHA (`BuyBox.astro`), copiado.
    // Se preseleccionaba la talla única y NUNCA el color único, así que el
    // botón de agregar quedaba `disabled` en todo el catálogo — un producto de
    // Wincol es `talla: "Única"` / `color: "Único"`, una sola variante.
    //
    // ⚠️ Esta lógica vive DOS VECES, acá y en la ficha. Por eso el bug apareció
    // en los dos lados a la vez y hubo que arreglarlo dos veces: es candidato a
    // unificarse en `lib/variantes.ts` (ver la deuda anotada en la bóveda).
    const tallasUnicas = tallasDisponibles(producto.variantes);
    if (tallasUnicas.length === 1) tallaSeleccionada = tallasUnicas[0];
    const coloresUnicos = coloresDisponibles(producto.variantes);
    if (coloresUnicos.length === 1) colorSeleccionado = coloresUnicos[0];
    actualizarEstado();

    modal.classList.remove("hidden");
    void panel.offsetWidth;
    backdrop.classList.remove("opacity-0");
    panel.classList.remove("translate-y-full");
    document.body.classList.add("overflow-hidden");
  }

  function cerrar() {
    backdrop.classList.add("opacity-0");
    panel.classList.add("translate-y-full");
    document.body.classList.remove("overflow-hidden");
    setTimeout(() => modal.classList.add("hidden"), 300);
  }

  window.addEventListener("abrir-selector-variante", ((evento: CustomEvent<ProductoParaSelector>) => {
    abrir(evento.detail);
  }) as EventListener);

  backdrop.addEventListener("click", cerrar);
  document.getElementById("selector-variante-cerrar")?.addEventListener("click", cerrar);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !modal.classList.contains("hidden")) cerrar();
  });

  panel.querySelector("[data-restar]")?.addEventListener("click", () => {
    cantidadInput.value = String(clamp(Number(cantidadInput.value) - 1));
  });
  panel.querySelector("[data-sumar]")?.addEventListener("click", () => {
    cantidadInput.value = String(clamp(Number(cantidadInput.value) + 1));
  });
  cantidadInput.addEventListener("change", () => {
    cantidadInput.value = String(clamp(Number(cantidadInput.value) || 1));
  });

  // El listener delegado en BaseLayout agrega al carrito al detectar el click
  // en [data-agregar-carrito]; acá solo cerramos el modal después.
  botonAgregar.addEventListener("click", () => {
    if (botonAgregar.disabled) return;
    cerrar();
  });
</script>
