---
import { construirEnlaceWhatsAppAsesor } from "../../lib/whatsapp";
import { COOKIE_REF } from "../../lib/atribucion";

// El comprador mayorista no viene a armar un carrito de a una talla: viene a
// cotizar por volumen. La acción dominante es hablar con el asesor (Arkco360)
// de una vez, y el catálogo queda como segunda opción para quien quiere mirar.
// Lección traída de Wincol: con una sola salida al catálogo, el tráfico pago
// se fugaba en el camino producto → talla → color → carrito → WhatsApp.
const enlaceAsesor = construirEnlaceWhatsAppAsesor(
  "Necesito una cotización por volumen.",
  Astro.cookies.get(COOKIE_REF)?.value ?? null,
);

const pasos = [
  { n: "01", titulo: "Nos cuenta qué necesita", texto: "Cantidades, tallas y el tipo de trabajo." },
  { n: "02", titulo: "Le armamos la cotización", texto: "Precio por volumen y disponibilidad real." },
  { n: "03", titulo: "Lo recibe con factura", texto: "Electrónica, con NIT, en todo el país." },
];
---

{/* Portada: «el único gesto grande» del manual. Plano Azul Mando, el símbolo
    a escala gigante saliendo por la derecha y la franja plata al pie. Sin
    fotografía a propósito: así no se parece al hero de Wincol y no hay una
    imagen pesada compitiendo con el LCP en móvil. */}
<section class="relative overflow-hidden bg-brand-500 text-white">
  <img
    src="/simbolo-negativo.svg"
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute -right-[22vw] top-1/2 w-[min(95vw,820px)] -translate-y-1/2 select-none opacity-[0.16] sm:-right-[12vw] lg:-right-[6vw] lg:opacity-100"
    width="820"
    height="820"
  />
  <div class="absolute inset-0 bg-gradient-to-r from-brand-500 via-brand-500/95 to-brand-500/10 lg:to-transparent" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-7xl px-4 pb-14 pt-12 sm:pb-20 sm:pt-16 lg:pb-24 lg:pt-24">
    <div class="max-w-2xl">
      <p class="flex items-center gap-3 text-sm font-semibold text-plata">
        <span class="h-[3px] w-8 bg-senal" aria-hidden="true"></span>
        Dotación y EPP para empresas
      </p>

      <h1 class="mt-5 text-[2.6rem] font-black leading-[0.95] tracking-[-0.04em] sm:text-6xl lg:text-[4.75rem]">
        Dotación completa para todo su equipo.
      </h1>

      <p class="mt-6 max-w-xl text-lg text-[#AEB4C4] sm:text-xl">
        Su equipo protegido antes del próximo turno. Escríbanos por WhatsApp y le
        armamos el pedido completo, sin recorrer el catálogo talla por talla.
      </p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href={enlaceAsesor}
          target="_blank"
          rel="noopener noreferrer"
          data-wa-origen="hero"
          class="inline-flex items-center justify-center gap-3 rounded-[6px] bg-white px-7 py-4 text-base font-bold text-brand-500 shadow-lg shadow-black/25 transition hover:bg-tecnico focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
        >
          <svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0 text-[#1FAF55]" fill="currentColor" aria-hidden="true">
            <path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.48-1.75-1.65-2.05-.17-.3-.02-.46.13-.6.14-.14.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.69.25-1.28.17-1.41-.07-.13-.27-.2-.57-.35Z"/>
            <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.87 9.87 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.13h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.11.82.83-3.04-.2-.31a8.17 8.17 0 0 1-1.25-4.36c0-4.53 3.7-8.22 8.23-8.22 2.2 0 4.26.86 5.81 2.41a8.16 8.16 0 0 1 2.41 5.82c0 4.53-3.69 8.21-8.23 8.21Z"/>
          </svg>
          Cotizar por WhatsApp
        </a>
        <a
          href="/categorias"
          class="inline-flex items-center justify-center gap-2 rounded-[6px] border border-white/25 px-6 py-4 text-base font-semibold text-white transition hover:border-white/60 hover:bg-white/5"
        >
          Ver el catálogo
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <p class="mt-4 text-sm text-[#8B92A8]">
        ¿Prefiere dejarlo por escrito? <a href="/cotizar" class="font-semibold text-plata underline underline-offset-4 hover:text-white">Arme su solicitud en dos pasos</a>
      </p>
    </div>

    <ol class="mt-14 grid gap-px overflow-hidden rounded-[6px] bg-white/10 sm:grid-cols-3 lg:mt-20 lg:max-w-3xl">
      {pasos.map((paso) => (
        <li class="bg-brand-500/90 p-5 backdrop-blur-sm">
          <span class="text-xs font-semibold tabular-nums text-[#8B92A8]">{paso.n}</span>
          <p class="mt-2 font-extrabold tracking-[-0.01em]">{paso.titulo}</p>
          <p class="mt-1 text-sm text-[#AEB4C4]">{paso.texto}</p>
        </li>
      ))}
    </ol>
  </div>

  <div class="franja-plata relative" aria-hidden="true"></div>
</section>
