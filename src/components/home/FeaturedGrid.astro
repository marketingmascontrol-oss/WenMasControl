---
import type { ProductoConRelaciones } from "../../../types/product";
import ProductCard from "../ui/ProductCard.astro";
import { obtenerResumenResenasPorProductos } from "../../lib/resenas";

interface Props {
  productos: ProductoConRelaciones[];
  titulo?: string;
  enlaceVerTodo?: string;
  textoVerTodo?: string;
}

const {
  productos,
  titulo = "EPP Destacado",
  enlaceVerTodo = "/categorias",
  textoVerTodo = "Ver todo el catálogo →",
} = Astro.props;

const resumenPorProducto = await obtenerResumenResenasPorProductos(productos.map((p) => p.id));
---

<section class="mx-auto max-w-7xl px-4 py-16 sm:py-20">
  <div>
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 class="text-3xl font-black leading-none tracking-[-0.035em] text-brand-500 sm:text-5xl">{titulo}</h2>
      <a href={enlaceVerTodo} class="text-sm font-semibold text-brand-500 underline-offset-4 hover:underline">{textoVerTodo}</a>
    </div>
  </div>

  {productos.length > 0 ? (
    <div class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-5 lg:grid-cols-4">
      {productos.map((producto) => (
        <ProductCard producto={producto} resumenResenas={resumenPorProducto.get(producto.id)} />
      ))}
    </div>
  ) : (
    <p class="mt-8 text-sm text-acero">Aún no hay productos publicados.</p>
  )}
</section>
