---
// Logos reales, subidos por el cliente y normalizados (trim + resize + webp)
// para que todos se vean con el mismo tratamiento visual en la tira.
interface Marca {
  nombre: string;
  logo: string;
}

const marcas: Marca[] = [
  { nombre: "3M", logo: "/marcas/3m.webp" },
  { nombre: "AIR", logo: "/marcas/air.webp" },
  { nombre: "Steelpro", logo: "/marcas/steelpro.webp" },
  { nombre: "Insafe", logo: "/marcas/insafe.webp" },
  { nombre: "Kondor", logo: "/marcas/kondor.webp" },
  { nombre: "Impacto", logo: "/marcas/impacto.webp" },
  { nombre: "Libus", logo: "/marcas/libus.webp" },
  { nombre: "Link Tech", logo: "/marcas/linktech.webp" },
  { nombre: "Mase", logo: "/marcas/mase.webp" },
  { nombre: "Croydon", logo: "/marcas/croydon.webp" },
  { nombre: "Portwest", logo: "/marcas/portwest.webp" },
];

// Grilla fija y no carrusel: en Wincol la tira se movía sola; acá las marcas
// se leen de un vistazo y no hay animación compitiendo con el catálogo.
---

<section class="mx-auto max-w-7xl px-4 pb-16 sm:pb-20">
  <div class="grid gap-6 border-t border-linea pt-10 sm:grid-cols-[180px_1fr] sm:gap-8">
    <p class="text-sm font-semibold text-acero">Marcas que distribuimos</p>
    <ul class="grid grid-cols-3 gap-px overflow-hidden rounded-[6px] border border-linea bg-linea sm:grid-cols-4 lg:grid-cols-6">
      {marcas.map((marca) => (
        <li class="flex h-20 items-center justify-center bg-white px-5">
          <img
            src={marca.logo}
            alt={marca.nombre}
            class="max-h-8 w-full object-contain opacity-60 grayscale transition hover:opacity-100 hover:grayscale-0"
            loading="lazy"
          />
        </li>
      ))}
      <li class="hidden items-center justify-center bg-white px-4 text-center text-xs font-semibold text-acero lg:flex">
        y más bajo pedido
      </li>
    </ul>
  </div>
</section>
