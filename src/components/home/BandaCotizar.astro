---
import { construirEnlaceWhatsAppAsesor } from "../../lib/whatsapp";
import { COOKIE_REF } from "../../lib/atribucion";

// Cierre de la home: quien bajó hasta acá ya miró y todavía no escribió. Se le
// ofrece la misma salida del hero, con el código de referencia puesto desde el
// servidor (no depende de que cargue el JavaScript), y se le dice qué conviene
// mandar: el miedo de escribir es no saber qué decir. De fondo, la foto de
// bodega entera, con el trabajador dotado a la vista a la derecha.
const enlaceAsesor = construirEnlaceWhatsAppAsesor(
  "Quiero cotizar la dotación de mi equipo.",
  Astro.cookies.get(COOKIE_REF)?.value ?? null,
);

const queMandar = ["Cargos y cuántas personas", "Tallas de cada uno", "Ciudad y fecha de entrega"];
---

<section class="mx-auto max-w-7xl px-4 py-16 sm:py-20">
  <div class="relative overflow-hidden rounded-2xl bg-brand-500 text-white">
    <img
      src="/fotos/banda-bodega-1983.webp"
      srcset="/fotos/banda-bodega-1000.webp 1000w, /fotos/banda-bodega-1983.webp 1983w"
      sizes="(min-width: 1280px) 1248px, 100vw"
      alt=""
      aria-hidden="true"
      loading="lazy"
      decoding="async"
      class="pointer-events-none absolute inset-0 h-full w-full select-none object-cover object-[78%_center]"
    />
    <div class="absolute inset-0 bg-brand-500/80 lg:bg-transparent lg:bg-gradient-to-r lg:from-brand-500 lg:via-brand-500/85 lg:to-brand-500/0" aria-hidden="true"></div>
    <div class="relative px-6 py-12 sm:px-10 sm:py-16 lg:max-w-[52%] lg:px-14 lg:py-20">
      <p class="flex items-center gap-3 text-sm font-semibold text-plata">
        <span class="h-[3px] w-8 bg-senal" aria-hidden="true"></span>
        Cotización por volumen
      </p>
      <h2 class="mt-4 text-3xl font-black leading-[0.98] tracking-[-0.035em] sm:text-5xl">
        ¿Dotación para 10 o para 500 personas?
      </h2>
      <p class="mt-4 max-w-lg text-lg text-[#AEB4C4]">
        Mándenos la lista y le devolvemos la cotización completa por WhatsApp, con precio por volumen.
      </p>

      <ul class="mt-6 grid gap-2 sm:grid-cols-3 lg:grid-cols-1 xl:grid-cols-3">
        {queMandar.map((item) => (
          <li class="flex items-center gap-2 rounded-[6px] bg-white/[0.06] px-3 py-2.5 text-sm font-semibold ring-1 ring-white/10">
            <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-plata text-brand-500" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7" /></svg>
            </span>
            {item}
          </li>
        ))}
      </ul>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a
          href={enlaceAsesor}
          target="_blank"
          rel="noopener noreferrer"
          data-wa-origen="banda-home"
          class="inline-flex items-center justify-center rounded-[6px] bg-white px-7 py-4 font-bold text-brand-500 shadow-lg shadow-black/25 transition hover:bg-tecnico"
        >
          Cotizar por WhatsApp
        </a>
        <a
          href="/cotizar"
          class="inline-flex items-center justify-center rounded-[6px] border border-white/25 px-6 py-4 font-semibold transition hover:border-white/60 hover:bg-white/5"
        >
          Prefiero dejarlo por escrito
        </a>
      </div>
    </div>

  </div>
</section>
