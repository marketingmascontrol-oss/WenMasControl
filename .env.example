# ── Supabase de +Control (proyecto propio, NO el de Wincol) ──
SUPABASE_URL=https://xxxxxxxx.supabase.co

# Bypasa RLS. Usada por los scripts y por src/lib/supabase-admin.ts (panel /admin).
# Nunca exponer al cliente/navegador.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Usada por las páginas públicas (lectura on-demand). Es de solo lectura por RLS.
SUPABASE_ANON_KEY=eyJ...

# Emails autorizados a entrar a /admin, separados por coma.
ADMIN_EMAILS=admin@mascontrol.com.co

# ── Sólo para `npm run copiar-wincol` (copia inicial del catálogo) ──
# Se LEE de Wincol, nunca se escribe. Con la anon key copia sólo lo publicado.
WINCOL_SUPABASE_URL=
WINCOL_SUPABASE_KEY=
